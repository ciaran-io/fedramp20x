        "P5",
        "P6",
        "P7",
        "P8",
        "P9",
        "E2",
        "E3"
      ],
      "requirements": [
        {
          "id": "SVC-1",
          "text": "Resource configuration is applied by automation. Manual configuration is a defect.",
          "ksis": [
            "KSI-SVC-ACM"
          ]
        },
        {
          "id": "SVC-2",
          "text": "Secrets live in secrets management (P6). Keys are held in the key management service (P5). Secrets rotate at least every 90 days and never appear in code, logs or tickets.",
          "ksis": [
            "KSI-SVC-ASM"
          ]
        },
        {
          "id": "SVC-3",
          "text": "The security team evaluates new tools and findings every quarter and records the improvements made.",
          "ksis": [
            "KSI-SVC-EIS"
          ]
        },
        {
          "id": "SVC-4",
          "text": "The offering does not keep residual access, credentials or data after a change. Deprecated resources are removed within 30 days.",
          "ksis": [
            "KSI-SVC-PRR"
          ]
        },
        {
          "id": "SVC-5",
          "text": "Customer data is deleted from production within 30 days of a verified customer request and from backups at the next backup expiry. Staging holds synthetic data only.",
          "ksis": [
            "KSI-SVC-RUD"
          ]
        },
        {
          "id": "SVC-6",
          "text": "Data at rest is encrypted. Queues, tables and volumes use customer-data keys from the key management service.",
          "ksis": [
            "KSI-SVC-SIN"
          ]
        },
        {
          "id": "SVC-7",
          "text": "Every data flow in the scope record uses TLS 1.2 or later with a valid certificate. Certificates renew automatically.",
          "ksis": [
            "KSI-SVC-VCM"
          ]
        },
        {
          "id": "SVC-8",
          "text": "Deployed images and packages are signed. The pipeline verifies the signature and a digest before release.",
          "ksis": [
            "KSI-SVC-VRI"
          ]
        }
      ],
      "indicators": [
        {
          "ksi": "KSI-SVC-ACM",
          "methods": [
            "acm-iac-config-automation",
            "acm-live-drift"
          ],
          "status": "pass"
        },
        {
          "ksi": "KSI-SVC-ASM",
