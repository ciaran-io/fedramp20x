    {
      "id": "POL-IAM",
      "title": "Identity and access management policy",
      "theme": "IAM",
      "owner": "CISO",
      "review_cadence": "Annual",
      "version": "0.1",
      "effective": "2026-11-19",
      "document": "documents/policies/POL-IAM.md",
      "resources": [
        "E6",
        "E7",
        "E8",
        "E9",
        "S4",
        "N1",
        "N2",
        "P1",
        "P5",
        "P6"
      ],
      "requirements": [
        {
          "id": "IAM-1",
          "text": "Account creation, change and removal are automated from the identity provider. Leavers lose access within 24 hours.",
          "ksis": [
            "KSI-IAM-AAM"
          ]
        },
        {
          "id": "IAM-2",
          "text": "Workforce sign-in uses phishing-resistant passwordless methods (WebAuthn or platform authenticators). No password-only path exists.",
          "ksis": [
            "KSI-IAM-APM"
          ]
        },
        {
          "id": "IAM-3",
          "text": "Access follows least privilege. Permissions unused for 90 days are removed. Access is reviewed every quarter.",
          "ksis": [
            "KSI-IAM-ELP"
          ]
        },
        {
          "id": "IAM-4",
          "text": "Production and tenant-data access is granted just in time through the access gateway (E6), with an approval, a reason and an expiry.",
          "ksis": [
            "KSI-IAM-JIT"
          ]
        },
        {
          "id": "IAM-5",
          "text": "Workloads authenticate with short-lived credentials. Static keys rotate at least every 90 days and are held in secrets management (P6).",
          "ksis": [
            "KSI-IAM-SNU"
          ]
        },
        {
          "id": "IAM-6",
          "text": "Suspicious account activity raises an alert. The on-call responder starts a response within the time set in the incident response plan.",
          "ksis": [
            "KSI-IAM-SUS"
          ]
        },
        {
          "id": "IAM-7",
          "text": "Support impersonation (S4) needs a recorded customer approval and writes an audit entry that the customer can see.",
          "ksis": [
            "KSI-IAM-ELP",
            "KSI-IAM-JIT"
          ]
        }
      ],
      "indicators": [
        {
