    {
      "id": "POL-CMT",
      "title": "Change management policy",
      "theme": "CMT",
      "owner": "Platform Lead",
      "review_cadence": "Annual",
      "version": "0.1",
      "effective": "2026-11-19",
      "document": "documents/policies/POL-CMT.md",
      "resources": [
        "E1",
        "E2",
        "E3",
        "P1",
        "P2",
        "P11"
      ],
      "requirements": [
        {
          "id": "CMT-1",
          "text": "Every change to a production resource is made through the pipeline. The pipeline logs the change, the author, the reviewer and the result.",
          "ksis": [
            "KSI-CMT-LMC"
          ]
        },
        {
          "id": "CMT-2",
          "text": "Production machine-based resources are replaced from a trusted image or build. Staff do not modify running resources by hand.",
          "ksis": [
            "KSI-CMT-RMV"
          ]
        },
        {
          "id": "CMT-3",
          "text": "The Platform Lead reviews the change procedure each year and after any failed or emergency change.",
          "ksis": [
            "KSI-CMT-RVP"
          ]
        },
        {
          "id": "CMT-4",
          "text": "Every deployment runs automated tests for integrity and security before release and checks that the deployed state matches the intended state after release.",
          "ksis": [
            "KSI-CMT-VTD"
          ]
        },
        {
          "id": "CMT-5",
          "text": "A change that matches a significant change rule is entered in the significant change log. The GRC Lead sends the required notice within the rule timeline (SCN rules).",
          "ksis": [
            "KSI-CMT-LMC",
            "KSI-CMT-RVP"
          ]
        }
      ],
      "indicators": [
        {
