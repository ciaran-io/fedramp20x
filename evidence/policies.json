    {
      "id": "POL-RPL",
      "title": "Recovery planning policy",
      "theme": "RPL",
      "owner": "Platform Lead",
      "review_cadence": "Every 90 days, and after any recovery test",
      "version": "0.1",
      "effective": "2026-11-19",
      "document": "documents/policies/POL-RPL.md",
      "resources": [
        "P3",
        "P4",
        "P12",
        "E3",
        "P1"
      ],
      "requirements": [
        {
          "id": "RPL-1",
          "text": "The recovery objectives are a recovery time of 8 hours and a recovery point of 4 hours. The Platform Lead reviews them at least every 90 days and records the result in environment/recovery-objectives.json.",
          "ksis": [
            "KSI-RPL-RRO"
          ]
        },
        {
          "id": "RPL-2",
          "text": "Backups run at least every 2 hours, are encrypted and are copied to a second US region (P12) into a vault that has a compliance-mode lock. Backup jobs and copy jobs are monitored and a failed job raises an alert.",
          "ksis": [
            "KSI-RPL-ABO"
          ]
        },
        {
          "id": "RPL-3",
          "text": "The recovery plan describes how a recovery environment is built from infrastructure code and how data is restored into it. It is kept in step with the architecture.",
          "ksis": [
            "KSI-RPL-ARP"
          ]
        },
        {
          "id": "RPL-4",
          "text": "A restore test runs at least every 6 months. It records the time taken, the data age restored and any failure.",
          "ksis": [
            "KSI-RPL-TRC"
          ]
        },
        {
          "id": "RPL-5",
          "text": "The recovery environment, once built, falls under the same scope record and controls as production.",
          "ksis": [
            "KSI-RPL-ARP"
          ]
        }
      ],
      "indicators": [
        {
          "ksi": "KSI-RPL-ABO",
          "methods": [
            "abo-iac-backup-policy",
            "abo-live-backup-currency"
          ],
          "status": "pass"
        },
        {
