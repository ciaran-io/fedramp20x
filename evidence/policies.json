    {
      "id": "POL-MLA",
      "title": "Monitoring, logging and auditing policy",
      "theme": "MLA",
      "owner": "Security Operations Lead",
      "review_cadence": "Annual",
      "version": "0.1",
      "effective": "2026-11-19",
