    {
      "id": "POL-CNA",
      "title": "Cloud-native architecture policy",
      "theme": "CNA",
      "owner": "Platform Lead",
      "review_cadence": "Annual, and after any architecture change",
      "version": "0.1",
      "effective": "2026-11-19",
      "document": "documents/policies/POL-CNA.md",
      "resources": [
        "P1",
        "P2",
        "P3",
        "P4",
        "P8",
        "P12",
        "E3"
      ],
      "requirements": [
        {
          "id": "CNA-1",
          "text": "Each resource has a documented function and the minimum privileges needed for it.",
          "ksis": [
            "KSI-CNA-DFP"
          ]
        },
        {
          "id": "CNA-2",
          "text": "Infrastructure is declared in code. A resource that exists outside the code is a defect and is removed or brought into the code within 5 business days.",
          "ksis": [
            "KSI-CNA-EIS"
          ]
        },
        {
          "id": "CNA-3",
          "text": "Hardening baselines from the secure configuration guide apply to every resource type.",
          "ksis": [
            "KSI-CNA-IBP"
          ]
        },
        {
          "id": "CNA-4",
          "text": "Public exposure is limited to the load balancer, gateway and web application firewall (P8). Each open port and public endpoint is justified in the scope record.",
          "ksis": [
            "KSI-CNA-MAT"
          ]
        },
        {
          "id": "CNA-5",
          "text": "Production runs in more than one availability zone. Cross-region encrypted backups meet the recovery objectives in policy POL-RPL.",
          "ksis": [
            "KSI-CNA-OFA"
          ]
        },
        {
          "id": "CNA-6",
          "text": "Inbound and outbound traffic is denied by default. Allowed flows match the flows in the scope record.",
          "ksis": [
            "KSI-CNA-RNT"
          ]
        },
        {
          "id": "CNA-7",
          "text": "The Platform Lead reviews protections each year and after any significant change.",
          "ksis": [
            "KSI-CNA-RVP"
          ]
        },
        {
          "id": "CNA-8",
          "text": "Production uses logical networks and security groups to separate tenants' workloads from operations tooling and from other trust zones.",
          "ksis": [
            "KSI-CNA-ULN"
          ]
        }
      ],
      "indicators": [
