        "P8",
        "E6",
        "E7"
      ],
      "requirements": [
        {
          "id": "MLA-1",
          "text": "Log access is limited to named security and operations roles. Log changes and deletions raise an alert.",
          "ksis": [
            "KSI-MLA-ALA"
          ]
        },
        {
          "id": "MLA-2",
          "text": "Resource configurations are evaluated against the baseline at least daily.",
          "ksis": [
            "KSI-MLA-EVC"
          ]
        },
        {
          "id": "MLA-3",
          "text": "Each in-scope resource logs authentication, authorisation, administrative, configuration and data-access events. Logs do not contain alert summaries or credentials.",
          "ksis": [
            "KSI-MLA-LET"
          ]
        },
        {
          "id": "MLA-4",
          "text": "Logs flow to the security monitoring stack (E4), which correlates events and raises alerts.",
          "ksis": [
            "KSI-MLA-OSM"
          ]
        },
        {
          "id": "MLA-5",
          "text": "Security staff review alerts daily and review log coverage each quarter. Logs are kept for 12 months.",
          "ksis": [
            "KSI-MLA-RVL"
          ]
        }
      ],
