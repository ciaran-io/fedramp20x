        "N1",
        "N2",
        "N3",
        "N5"
      ],
      "requirements": [
        {
          "id": "CED-1",
          "text": "All staff complete general security training within 30 days of hire and once every 12 months.",
          "ksis": [
            "KSI-CED-RAT"
          ]
        },
        {
          "id": "CED-2",
          "text": "Staff with production access, support staff with tenant access and incident responders complete role-specific training before access is granted.",
          "ksis": [
            "KSI-CED-RAT"
          ]
        },
        {
          "id": "CED-3",
          "text": "Engineering staff complete secure software delivery training each year.",
          "ksis": [
            "KSI-CED-RAT"
          ]
        },
        {
          "id": "CED-4",
          "text": "Staff on the incident and recovery roster take part in at least one recovery exercise each year.",
          "ksis": [
            "KSI-CED-RAT"
          ]
        },
        {
          "id": "CED-5",
          "text": "The GRC Lead reviews training completion and effectiveness each quarter. Effectiveness evidence includes phishing exercise results and incident root causes.",
          "ksis": [
            "KSI-CED-RAT"
          ]
        }
      ],
      "indicators": [
