    {
      "id": "POL-PIY",
      "title": "Policy and inventory policy",
      "theme": "PIY",
      "owner": "GRC Lead",
      "review_cadence": "Annual",
      "version": "0.1",
      "effective": "2026-11-19",
      "document": "documents/policies/POL-PIY.md",
      "resources": [
        "N3",
        "N4",
        "E1",
        "E5",
        "P1"
      ],
      "requirements": [
        {
          "id": "PIY-1",
          "text": "The inventory of in-scope resources is generated from the scope record and checked against live state. A live resource with no scope ID is a finding.",
          "ksis": [
            "KSI-PIY-GIV"
          ]
        },
        {
          "id": "PIY-2",
          "text": "The executive team reviews security status, risks and policy exceptions every quarter. The review is minuted.",
          "ksis": [
            "KSI-PIY-RES"
          ]
        },
        {
          "id": "PIY-3",
          "text": "The executive team reviews security spending against the risk register each year.",
          "ksis": [
            "KSI-PIY-RIS"
          ]
        },
        {
          "id": "PIY-4",
          "text": "Security requirements are part of each stage of the software development lifecycle. Design review, code review and dependency scanning are required for every release.",
          "ksis": [
            "KSI-PIY-RSD"
          ]
        },
        {
          "id": "PIY-5",
          "text": "Orrinwick publishes a vulnerability disclosure route, answers reports within 3 business days and tracks each report to closure.",
          "ksis": [
            "KSI-PIY-RVD"
          ]
        },
        {
          "id": "PIY-6",
          "text": "The GRC Lead reviews every policy in this set at its stated cadence and records the review date.",
          "ksis": [
            "KSI-PIY-RES"
          ]
        }
      ],
